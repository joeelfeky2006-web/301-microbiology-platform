# ==============================================================================
# MedAtlas Egypt (Micro 301) — Local & Production Environment Configuration
# ==============================================================================
# Setup Instructions:
# 1. Copy this file and create a new local environment file named: .env.local
#    (e.g., cp .env.example .env.local)
# 2. Fill in the values below with your project credentials.
# 3. WARNING: Never commit .env.local or secret API keys to Git / version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Database, Authentication & Storage)
# ------------------------------------------------------------------------------
# Find these in your Supabase Dashboard -> Project Settings -> API:

# [REQUIRED] Supabase Project URL:
# Replace with your actual project URL (e.g., https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# [REQUIRED] Supabase Public Anonymous Key:
# Safe to expose in client-side code; subject to Row-Level Security (RLS) policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# [REQUIRED FOR ADMIN & SERVER ROUTES] Supabase Service Role Secret Key:
# Found under "Project API keys" -> "service_role" (secret).
# WARNING: Keep this strictly confidential! It is only accessed on the server
# and bypasses Row-Level Security for CMS administrative uploads and migrations.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Google Gemini AI API Configuration
# ------------------------------------------------------------------------------
# Provider used by the centralized AI pipeline: gemini (default), groq, openai, or anthropic.
AI_PROVIDER=gemini
# Comma-separated failover order; only fully configured providers are attempted.
# Preferred production order: Gemini primary, Groq fallback.
AI_PROVIDER_PRIORITY=gemini,groq,openai,anthropic
# Obtain your Gemini API Key from Google AI Studio: https://aistudio.google.com/

# [REQUIRED FOR AI FEATURES] Google Gemini API Key:
# Used server-side for Dr. Atlas Tutor, clinical case studies, quizzes, and summaries.
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Primary Gemini Model used for complex reasoning & tutoring:
# Options: gemini-2.5-flash, gemini-1.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# Fallback Gemini Model used during high quota usage or transient rate limits:
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Optional Groq fallback (OpenAI-compatible API). Key alone is enough; model has a default.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional alternative providers. Set the matching key and model when AI_PROVIDER changes.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# ANTHROPIC_MAX_TOKENS=4096

# ------------------------------------------------------------------------------
# 3. Case-study answer sealing (server-only)
# ------------------------------------------------------------------------------
# Long random secret used to AES-256-GCM seal case-study answer keys in transit.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CASE_SEAL_SECRET=

# ------------------------------------------------------------------------------
# 4. Super Admin & Platform Access
# ------------------------------------------------------------------------------
# The primary administrator email granted Super Admin access in the portal:
NEXT_PUBLIC_ADMIN_EMAIL=joeelfeky2006@gmail.com

# ------------------------------------------------------------------------------
# 5. Canonical Site URL & SEO Metadata
# ------------------------------------------------------------------------------
# Local development default: http://localhost:3000
# Production deployment: https://your-production-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 6. Student Support & Community Channels
# ------------------------------------------------------------------------------
# Official WhatsApp support phone number (international format, no '+' or spaces):
# Example: 201000000000 for Egypt (+20)
NEXT_PUBLIC_WHATSAPP_NUMBER=201000000000
