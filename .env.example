# ==============================================================================
# MedAtlas Egypt (Micro 301) — Environment Configuration
# ==============================================================================
# Setup:
#   1. Copy to .env.local  →  cp .env.example .env.local   (Windows: copy .env.example .env.local)
#   2. Fill in real values. Never commit .env.local or any file with live secrets.
#
# Naming:
#   - NEXT_PUBLIC_*  → bundled into the browser. Safe for public keys / non-secrets only.
#   - All other vars → SERVER-ONLY. Never prefix secrets with NEXT_PUBLIC_.
#
# This project already uses NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY
# (not bare SUPABASE_URL / SUPABASE_ANON_KEY). Keep those names; do not rename in code.
# ==============================================================================

# ------------------------------------------------------------------------------
# A. PUBLIC (client-safe) — NEXT_PUBLIC_*
# ------------------------------------------------------------------------------

# [REQUIRED] Supabase project URL (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# [REQUIRED] Supabase anon / publishable key (RLS-protected; OK in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Super-admin email used as a bootstrap allowlist in the portal
NEXT_PUBLIC_ADMIN_EMAIL=joeelfeky2006@gmail.com

# Canonical site origin (auth redirects, SEO, sitemap)
# Local: http://localhost:3000
# Production: https://your-production-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp support number (international digits only, no + or spaces)
# Example Egypt: 201000000000
NEXT_PUBLIC_WHATSAPP_NUMBER=201000000000

# Optional: only if you intentionally use a browser analytics SDK later.
# Prefer server ANALYTICS_KEY — clients post to /api/analytics/event instead.
# NEXT_PUBLIC_ANALYTICS_KEY=


# ------------------------------------------------------------------------------
# B. SERVER-ONLY — Supabase privileged access
# ------------------------------------------------------------------------------

# [REQUIRED for admin/CMS/AI server routes] service_role key
# Bypasses RLS. Never expose to the client. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here


# ------------------------------------------------------------------------------
# C. SERVER-ONLY — AI providers (Phase 5 router)
# ------------------------------------------------------------------------------
# Primary provider name and failover order. Only fully configured providers run.
AI_PROVIDER=gemini
AI_PROVIDER_PRIORITY=gemini,groq,openai,anthropic

# Gemini (default primary) — https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Groq fallback (OpenAI-compatible). Key alone is enough; model has a default.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional additional providers
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# ANTHROPIC_MAX_TOKENS=4096

# Case-study answer sealing (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CASE_SEAL_SECRET=


# ------------------------------------------------------------------------------
# D. SERVER-ONLY — Payments (Phase 7 architecture — live OFF by default)
# ------------------------------------------------------------------------------
# Master switch. Must be exactly "true" to attempt provider checkout / fulfill.
# Leave unset/false for beta (admin grant credits instead).
# PAYMENTS_LIVE=false

# PAYMENT_PROVIDER=paymob
# PAYMOB_API_KEY=
# PAYMOB_INTEGRATION_ID=
# PAYMOB_IFRAME_ID=
# PAYMOB_HMAC_SECRET=
# Webhook (server-only): POST /api/payments/paymob/webhook
# Catalog: GET /api/payments/packages  (one-time packs + membership plans)
# Orders:  POST /api/payments/orders  (auth; never trusts client "paid")
# Memberships (Phase 8, no recurring bill): GET /api/memberships
# Manual assign: POST /api/admin/memberships  (super_admin)


# ------------------------------------------------------------------------------
# E. SERVER-ONLY — Product analytics (Phase 9 — PostHog-compatible)
# ------------------------------------------------------------------------------
# Disabled unless ANALYTICS_KEY is set. Set ANALYTICS_ENABLED=false to force off.
# ANALYTICS_ENABLED=true
# ANALYTICS_KEY=phc_your_posthog_project_key
# ANALYTICS_ENDPOINT=https://us.i.posthog.com/capture/
# Client bridge: POST /api/analytics/event (allowlisted events, hashed user ids)

# Optional rough AI cost estimate for admin observability (USD per million tokens)
# AI_COST_INPUT_USD_PER_MTOK=0.1
# AI_COST_OUTPUT_USD_PER_MTOK=0.4
